// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  role             String   @default("learner")
  xp               Int      @default(0)
  level            Int      @default(1)
  streakCount      Int      @default(0)
  lastActiveDate   DateTime?
  fullName         String?
  username         String?  @unique
  professionalRole String   @default("student")
  supabaseAuthId   String?  @unique
  profilePhotoUrl  String?
  /// Total AI quiz attempts saved (denormalized; same as COUNT AiQuizSubmission for this user). For analytics / Supabase queries.
  aiQuizSubmissionCount Int @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  moduleProgress     UserModuleProgress[]
  lessonProgress     UserLessonProgress[]
  quizImportBatches   QuizImportBatch[]
  aiQuizCollections   AiQuizCollection[]
  aiQuizSubmissions   AiQuizSubmission[]
}

model Course {
  id          String   @id @default(cuid())
  code        String   @unique // e.g., "BACS1013"
  title       String   // e.g., "Problem Solving & Programming"
  description String?  @db.Text
  xpReward    Int      @default(500)
  estimatedHrs Int     @default(20)
  difficulty  String   // e.g., "Beginner", "Intermediate", "Hard"
  avgScore    Int      @default(0)
  aiInsights  String?  @db.Text
  category    String?  // e.g., "Computer Science", "Web Development"
  year        Int?     // e.g., 1, 2
  
  // Prerequisite logic
  prerequisiteId String?
  prerequisite   Course?   @relation("CoursePrerequisites", fields: [prerequisiteId], references: [id])
  requiredFor    Course[]  @relation("CoursePrerequisites")

  modules     Module[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  order       Int      // 1, 2, 3...
  title       String   // e.g., "Introduction to Complexity"
  description String?  @db.Text
  imageUrl    String?
  iconName    String?  // Material icon name
  
  // Roadmap data
  numLessons  Int      @default(0)
  numProblems Int      @default(0)
  
  lessons     Lesson[]
  userProgress UserModuleProgress[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lesson {
  id          String   @id @default(cuid())
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  
  order       Int
  title       String   // e.g., "Static vs Dynamic Arrays"
  durationMin Int      @default(10)
  type        String   @default("reading") // "reading", "quiz", "coding"
  content     String?  @db.Text
  
  userProgress UserLessonProgress[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserModuleProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  
  status      String   @default("available") // "available", "in-progress", "completed", "locked"
  progress    Int      @default(0) // 0-100
  grade       String?  // e.g., "A+"
  
  completedAt DateTime?
  updatedAt   DateTime @updatedAt

  @@unique([userId, moduleId])
}

model UserLessonProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  isCompleted Boolean  @default(false)
  completedAt DateTime?
  
  @@unique([userId, lessonId])
}

// Admin quiz import: batch + files on disk (paths in relativePath)
model QuizImportBatch {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseCode String?
  courseNote String?  @db.Text
  createdAt  DateTime @default(now())
  files      QuizImportFile[]
  aiQuizCollections AiQuizCollection[]
}

/// AI-generated MCQ set from imported files (Path A: Gemini file → JSON → DB).
model AiQuizCollection {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  batchId    String?
  batch      QuizImportBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  title      String
  courseCode String?
  courseNote String?  @db.Text
  model      String?
  createdAt   DateTime @default(now())
  questions   AiQuizQuestion[]
  submissions AiQuizSubmission[]
}

/// Learner attempt on an AI quiz (stored in Postgres / Supabase for analytics & AI insights).
model AiQuizSubmission {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectionId   String
  collection     AiQuizCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  score          Int
  totalQuestions Int
  detailJson     Json
  createdAt      DateTime         @default(now())

  @@index([userId])
  @@index([collectionId])
  @@index([userId, collectionId])
}

model AiQuizQuestion {
  id            String           @id @default(cuid())
  collectionId  String
  collection    AiQuizCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  orderIndex    Int
  stem          String           @db.Text
  choices       Json
  correctIndex  Int
  explanation   String?          @db.Text
  sourceSnippet String?          @db.Text

  @@index([collectionId])
}

model QuizImportFile {
  id           String          @id @default(cuid())
  batchId      String
  batch        QuizImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  originalName String
  mimeType     String
  size         Int
  relativePath String
}

// Session table created by connect-pg-simple for Express sessions
model Session {
  sid    String   @id
  sess   Json     @db.JsonB
  expire DateTime @db.Timestamptz(6)

  @@index([expire])
  @@map("session")
}
