# Database connection URLs
# For Supabase: Use pooler (port 6543) for regular queries, direct (port 5432) for migrations.
# AI quiz submissions (AiQuizSubmission) and per-user counts (User.aiQuizSubmissionCount) live in this DB.
DATABASE_URL="postgresql://USER:PASSWORD@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?schema=public"
# Optional: Explicitly set direct connection URL for migrations (if different from DATABASE_URL)
# DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres?schema=public"

SESSION_SECRET="change-me"
PORT=4000
# Session cookie: SameSite=None + Secure for HTTPS API when the web app is on another origin.
# Prefer NODE_ENV=production on the host; if that is unset, set SESSION_CROSS_SITE_COOKIES=true instead.
# SESSION_CROSS_SITE_COOKIES=true
# CORS: frontend origin(s), no trailing slash. Multiple: comma-separated (production + Vercel preview URLs).
CLIENT_ORIGIN="http://localhost:5173"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_JWT_AUD="authenticated"
# Service role key: storage uploads + sync user type to Supabase Auth (user_metadata.user_type)
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Frontend Supabase anon key (for client-side operations)
# VITE_SUPABASE_ANON_KEY="your-anon-key"

# Google AI (Gemini) — Path A: generate quiz questions from imported files
# GEMINI_API_KEY="your-api-key"
# Optional model id (default: gemini-2.5-flash). Heavier reasoning: gemini-2.5-pro
# GEMINI_MODEL="gemini-2.5-flash"
