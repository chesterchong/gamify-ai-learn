# Local dev: Express API (used when Vite is in dev mode).
VITE_API_URL="http://localhost:4000"

# --- Vercel + separate backend (e.g. *.vercel.app frontend + *-backend.vercel.app API) ---
# Different subdomains are cross-site: the browser often blocks session cookies if VITE_API_URL
# is the backend host. Fix: proxy /api on the SPA host (see frontend/vercel.json) and REMOVE
# VITE_API_URL from the Vercel project env so production uses same-origin requests.
# If you rename the backend deployment, update the "destination" URL in vercel.json.

VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
